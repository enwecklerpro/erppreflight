{
  "name": "erppreflight-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "test:python": "node scripts/run-pytest.mjs",
    "check:deps": "node scripts/check-no-dependency-soup.mjs",
    "check:no-production-facades": "node scripts/check-no-production-facades.mjs",
    "check:production-truth": "node scripts/check-production-truth.mjs",
    "codegen:api": "pnpm --filter @erppreflight/web codegen:api",
    "test:e2e": "playwright test",
    "test:e2e:mocked": "pnpm exec playwright test tests/e2e/preflight-pipeline.mocked-ui.spec.ts",
    "test:e2e:live": "pnpm exec playwright test tests/e2e/preflight-pipeline.live.spec.ts",
    "smoke:live": "bash scripts/e2e-live-smoke.sh",
    "smoke:ui": "node scripts/e2e-ui-smoke.cjs",
    "smoke:commercial": "python3 scripts/e2e-commercial-smoke.py",
    "smoke:commercial-ui": "node scripts/e2e-commercial-ui.cjs",
    "smoke:account-ui": "node scripts/e2e-account-ui-smoke.cjs",
    "smoke:findings": "node scripts/e2e-findings-smoke.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.13.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
