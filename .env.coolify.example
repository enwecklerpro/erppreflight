# ==============================================================================
# ERP Preflight — Coolify / Hostinger Production Environment Variables (.env)
# ==============================================================================
# Used by: docker-compose.coolify.yml (repo root) — the live Coolify deployment.
# Place these values into your Coolify Application → Environment Variables.
#
# Internal service addresses (DATABASE_URL, REDIS_URL, S3_ENDPOINT,
# ANALYSIS_SERVICE_URL) and container ports (api 3001, web 3000,
# analysis-python 8000) are fixed inside docker-compose.coolify.yml and are
# NOT read from this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# Domains & Routing
# ------------------------------------------------------------------------------
# Build-time for Next.js: changing it requires a rebuild of the web image.
NEXT_PUBLIC_API_URL=https://api.erppreflight.com
CORS_ORIGIN=https://erppreflight.com,https://www.erppreflight.com

# ------------------------------------------------------------------------------
# PostgreSQL 16 + pgvector (REQUIRED)
# ------------------------------------------------------------------------------
POSTGRES_DB=erppreflight
POSTGRES_USER=erppreflight
POSTGRES_PASSWORD=GENERATE_SECURE_STRONG_PASSWORD_HERE
# Abort API startup if a migration fails (recommended in production).
STRICT_MIGRATIONS=true
# Migrations run with DATABASE_URL (schema owner). Set false to manage them manually.
AUTO_MIGRATE=true
# Row-Level Security enforcement: tenant-scoped transactions run
# `SET LOCAL ROLE erppreflight_app` (NOSUPERUSER NOBYPASSRLS, created by
# migration 010). Keep the default; `none` disables it (NOT recommended).
DB_RUNTIME_ROLE=erppreflight_app
# Optional dedicated runtime login for the API pool (non-superuser, member of
# erppreflight_app, BYPASSRLS only if system paths need it). Empty = DATABASE_URL.
APP_DATABASE_URL=

# ------------------------------------------------------------------------------
# Redis 7.2 — internal-only network, no requirepass configured.
# Leave empty unless you also add `--requirepass` to the redis service.
# ------------------------------------------------------------------------------
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# MinIO / S3 Object Storage (REQUIRED)
# ------------------------------------------------------------------------------
S3_ACCESS_KEY=GENERATE_MINIO_ACCESS_KEY_HERE
S3_SECRET_KEY=GENERATE_MINIO_SECRET_KEY_HERE
S3_REGION=us-east-1
S3_BUCKET_QUARANTINE=erppreflight-quarantine
S3_BUCKET_CLEAN=erppreflight-clean
S3_BUCKET_REPORTS=erppreflight-reports

# ------------------------------------------------------------------------------
# Authentication & Encryption (REQUIRED)
# ------------------------------------------------------------------------------
# openssl rand -base64 48
JWT_SECRET=GENERATE_SECURE_JWT_SECRET_AT_LEAST_64_CHARS_HERE
JWT_EXPIRES_IN=7d
# openssl rand -hex 32
MASTER_ENCRYPTION_KEY=GENERATE_32_BYTE_HEX_KEY_HERE
# JWT_SECRET, MASTER_ENCRYPTION_KEY, S3_ACCESS_KEY, S3_SECRET_KEY and DATABASE_URL are
# REQUIRED with NODE_ENV=production: the API refuses to start if any is missing or
# uses a publicly known default (e.g. minioadmin).

# ------------------------------------------------------------------------------
# One-time Super Admin bootstrap (optional)
# Creates exactly one SUPER_ADMIN if the email does not exist yet. Existing
# accounts are never modified. Remove the password after first login.
# ------------------------------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=
# >= 12 characters
ADMIN_BOOTSTRAP_PASSWORD=

# ------------------------------------------------------------------------------
# Observability & API docs
# ------------------------------------------------------------------------------
# Bearer token for Prometheus scraping of GET /api/v1/metrics (>= 16 chars).
# Empty: endpoint only available to Super Admin sessions (404 for anonymous).
METRICS_TOKEN=
# Swagger UI (/api/v1/docs) is disabled in production unless true.
ENABLE_SWAGGER=false

# ------------------------------------------------------------------------------
# E-mail delivery & account lifecycle (REQUIRED in production)
# Used for e-mail verification, password reset, organization invitations and
# security notifications. The API refuses to start in production without
# MAIL_TRANSPORT and MAIL_FROM.
#   smtp : any SMTP relay (implicit TLS on 465, STARTTLS on 587). Credentials are
#          never sent over an unencrypted connection.
#   http : transactional provider API — MAIL_HTTP_PROVIDER=resend|postmark.
#   dev  : stores messages in the mail_outbox table and serves them at
#          GET /api/v1/dev/mail/messages?to=<address> (header X-Dev-Mailbox-Token).
#          Only for staging / E2E stacks; in production it requires
#          MAIL_DEV_OUTBOX_TOKEN (>= 24 chars) and nothing is delivered.
# ------------------------------------------------------------------------------
MAIL_TRANSPORT=smtp
MAIL_FROM="ERP Preflight <no-reply@erppreflight.com>"
# Public web origin used in e-mail links (defaults to the first CORS_ORIGIN).
APP_PUBLIC_URL=https://erppreflight.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# tls | starttls | none (default: tls for port 465, otherwise starttls)
SMTP_SECURE=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_TIMEOUT_MS=20000
# HTTP provider alternative (MAIL_TRANSPORT=http)
MAIL_HTTP_PROVIDER=resend
MAIL_HTTP_URL=
MAIL_HTTP_API_KEY=
# Dev mailbox token (MAIL_TRANSPORT=dev only; leave empty in production)
MAIL_DEV_OUTBOX_TOKEN=
# Unverified accounts can sign in and upload but cannot run analyses, export
# reports, mint API keys or send invitations. Set false only for closed pilots.
EMAIL_VERIFICATION_REQUIRED=true

# ------------------------------------------------------------------------------
# Billing (Stripe). Without STRIPE_SECRET_KEY checkout/portal return 503 in production.
# Checkout returnUrl must be on an origin listed in CORS_ORIGIN.
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Antivirus (ClamAV) — MUST stay false in production (fail-closed ingestion)
# ------------------------------------------------------------------------------
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_MOCK_MODE=false
