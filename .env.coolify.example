# ==============================================================================
# ERP Preflight — Coolify / Hostinger Production Environment Variables (.env)
# ==============================================================================
# Used by: docker-compose.coolify.yml (repo root) — the live Coolify deployment.
# Place these values into your Coolify Application → Environment Variables.
#
# Internal service addresses (DATABASE_URL, REDIS_URL, S3_ENDPOINT,
# ANALYSIS_SERVICE_URL) and container ports (api 3001, web 3000,
# analysis-python 8000) are fixed inside docker-compose.coolify.yml and are
# NOT read from this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# Domains & Routing
# ------------------------------------------------------------------------------
# Build-time for Next.js: changing it requires a rebuild of the web image.
NEXT_PUBLIC_API_URL=https://api.erppreflight.com
CORS_ORIGIN=https://erppreflight.com,https://www.erppreflight.com
# Number of reverse-proxy hops whose X-Forwarded-For is trusted (default 1 in production:
# Traefik). Decides the client address for auth rate limits and organization IP
# allowlists; set it to the real hop count, never higher (forged headers would count).
TRUST_PROXY=1
# Public origin of the website: canonical URLs, hreflang, sitemap, Open Graph.
NEXT_PUBLIC_APP_URL=https://erppreflight.com
# Optional: API base URL used by the web SERVER (knowledge pages, sitemap) — e.g. the
# internal network address. Empty = NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=http://api:3001

# ------------------------------------------------------------------------------
# Legal / operator details (imprint, privacy policy, subprocessors, DPA request)
# Read by the web server at runtime. Nothing is invented: while COMPANY_NAME,
# ADDRESS and EMAIL are empty, the legal pages show "operator details not configured".
# ------------------------------------------------------------------------------
NEXT_PUBLIC_LEGAL_COMPANY_NAME=
# Address lines separated by "|", e.g. "Musterstraße 1|12345 Berlin|Germany"
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_REPRESENTATIVE=
# e.g. "Amtsgericht Berlin-Charlottenburg, HRB 000000"
NEXT_PUBLIC_LEGAL_REGISTER=
NEXT_PUBLIC_LEGAL_VAT_ID=
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_LEGAL_PHONE=
# Responsible for content (§ 18 Abs. 2 MStV)
NEXT_PUBLIC_LEGAL_RESPONSIBLE_PERSON=
# Subprocessors: entries "|"-separated, fields ";"-separated: "Name;Purpose;Location|..."
NEXT_PUBLIC_LEGAL_SUBPROCESSORS=

# Public knowledge base: seed the reviewed EN/DE starter articles on API boot
# (idempotent; never overwrites edited or archived articles). Set false to disable.
KNOWLEDGE_SEED=true

# ------------------------------------------------------------------------------
# PostgreSQL 16 + pgvector (REQUIRED)
# ------------------------------------------------------------------------------
POSTGRES_DB=erppreflight
POSTGRES_USER=erppreflight
POSTGRES_PASSWORD=GENERATE_SECURE_STRONG_PASSWORD_HERE
# Abort API startup if a migration fails (recommended in production).
STRICT_MIGRATIONS=true
# Migrations run in the one-shot compose job `migrate` (schema owner = DATABASE_URL) after
# the `db-backup` job has dumped the database; the API starts only when both exited 0
# (DEPLOYMENT_GUIDE.md §6a). AUTO_MIGRATE=true additionally lets the API container migrate at
# start — a fallback for runtimes without compose depends_on conditions (no automatic backup).
AUTO_MIGRATE=false
# Pre-migration backup: auto (dump only when the release ships pending migrations) | always | off
PREMIGRATION_BACKUP=auto
# Number of pre-migration dumps kept in the volume erppreflight_premigration_backups
PREMIGRATION_BACKUP_KEEP=10
# Row-Level Security enforcement: tenant-scoped transactions run
# `SET LOCAL ROLE erppreflight_app` (NOSUPERUSER NOBYPASSRLS, created by
# migration 010). Keep the default; `none` disables it (NOT recommended).
DB_RUNTIME_ROLE=erppreflight_app
# Optional dedicated runtime login for the API pool (non-superuser, member of
# erppreflight_app, BYPASSRLS only if system paths need it). Empty = DATABASE_URL.
APP_DATABASE_URL=

# ------------------------------------------------------------------------------
# Redis 7.2 — internal-only network, no requirepass configured.
# Leave empty unless you also add `--requirepass` to the redis service.
# ------------------------------------------------------------------------------
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# MinIO / S3 Object Storage (REQUIRED)
# ------------------------------------------------------------------------------
S3_ACCESS_KEY=GENERATE_MINIO_ACCESS_KEY_HERE
S3_SECRET_KEY=GENERATE_MINIO_SECRET_KEY_HERE
S3_REGION=us-east-1
S3_BUCKET_QUARANTINE=erppreflight-quarantine
S3_BUCKET_CLEAN=erppreflight-clean
S3_BUCKET_REPORTS=erppreflight-reports

# ------------------------------------------------------------------------------
# Authentication & Encryption (REQUIRED)
# ------------------------------------------------------------------------------
# openssl rand -base64 48
JWT_SECRET=GENERATE_SECURE_JWT_SECRET_AT_LEAST_64_CHARS_HERE
JWT_EXPIRES_IN=7d
# openssl rand -hex 32
MASTER_ENCRYPTION_KEY=GENERATE_32_BYTE_HEX_KEY_HERE
# JWT_SECRET, MASTER_ENCRYPTION_KEY, S3_ACCESS_KEY, S3_SECRET_KEY and DATABASE_URL are
# REQUIRED with NODE_ENV=production: the API refuses to start if any is missing or
# uses a publicly known default (e.g. minioadmin).

# ------------------------------------------------------------------------------
# Browser session cookie & CSRF (modules/auth/session-cookie.ts, csrf.guard.ts)
# ------------------------------------------------------------------------------
# Browsers authenticate ONLY with the HttpOnly cookie `erppreflight_session` set by the
# API (no token in localStorage). Cookie-authenticated POST/PUT/PATCH/DELETE requests
# need the `X-CSRF-Token` header (value from the `erp_csrf` cookie, the login response
# or GET /api/v1/auth/csrf) and an Origin/Referer listed in CORS_ORIGIN or APP_PUBLIC_URL;
# otherwise 403 CSRF_REJECTED. CLI / local agent / scripts use Authorization: Bearer or
# X-Api-Key and are not affected.
#
# Production topology: web on erppreflight.com, API on api.erppreflight.com. Both are
# the SAME SITE (registrable domain erppreflight.com), so the default host-only,
# SameSite=Lax, Secure cookie on api.erppreflight.com is sent with the web app's
# credentialed fetches — no extra setting is required. CORS allows credentials only
# for the origins in CORS_ORIGIN (keep it to the web origins, https only).
#
# Optional: share the cookies with the web host (Next.js middleware can see the real
# session cookie, script can read erp_csrf directly instead of calling /auth/csrf).
# Bare parent domain, no scheme/port. Leave empty for host-only cookies (recommended).
SESSION_COOKIE_DOMAIN=
# lax (default) | strict | none. `none` is only for a web app on a DIFFERENT site
# (e.g. a *.sslip.io test domain calling api.erppreflight.com); it forces Secure, the
# web origin must be in CORS_ORIGIN, and browsers that block third-party cookies will
# still refuse it — serve web and API from one registrable domain instead.
SESSION_COOKIE_SAMESITE=lax
# Secure cookies (default true when NODE_ENV=production; false is rejected in production).
SESSION_COOKIE_SECURE=

# ------------------------------------------------------------------------------
# One-time Super Admin bootstrap (optional)
# Creates exactly one SUPER_ADMIN if the email does not exist yet. Existing
# accounts are never modified. Remove the password after first login.
# ------------------------------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=
# >= 12 characters
ADMIN_BOOTSTRAP_PASSWORD=

# ------------------------------------------------------------------------------
# Observability & API docs
# ------------------------------------------------------------------------------
# Bearer token for Prometheus scraping of GET /api/v1/metrics (>= 16 chars).
# Empty: endpoint only available to Super Admin sessions (404 for anonymous).
METRICS_TOKEN=
# Swagger UI (/api/v1/docs) is disabled in production unless true.
ENABLE_SWAGGER=false
# Scalar API reference (/api/v1/reference) + /api/v1/openapi.json in production (self-hosted bundle).
ENABLE_API_REFERENCE=false
# Pino JSON logs: trace|debug|info|warn|error (secrets/tokens are redacted at the logger).
LOG_LEVEL=info
# OpenTelemetry traces (API + analysis-python). Empty = tracing off (no SDK started).
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer <collector token>
OTEL_SERVICE_NAME=erppreflight-api
# Error reporting (Sentry protocol, no SDK). Empty = no-op reporter. 5xx only, no bodies/headers.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=

# ------------------------------------------------------------------------------
# Public API URL (OIDC redirect_uri, agent/CLI instructions). Work-item deep links and
# the SSO completion redirect use APP_PUBLIC_URL (see "E-mail delivery" below).
# ------------------------------------------------------------------------------
API_PUBLIC_URL=https://api.erppreflight.com
# Optional override for the OIDC redirect_uri base (defaults to API_PUBLIC_URL).
SSO_REDIRECT_BASE_URL=

# ------------------------------------------------------------------------------
# Enterprise integrations (connectors, webhooks, SSO/SCIM, local agent)
# Connector/webhook/IdP credentials are entered per organization in the UI and stored
# AES-256-GCM encrypted (key derived from MASTER_ENCRYPTION_KEY). None belong here.
# ------------------------------------------------------------------------------
# Key rotation: set the old key here after changing MASTER_ENCRYPTION_KEY; stored secrets
# stay readable and are re-encrypted with the new key on next write.
MASTER_ENCRYPTION_KEY_PREVIOUS=
# Outbound calls (connectors, webhooks, OIDC, DNS) refuse private/loopback targets unless true.
# Only enable for on-prem deployments that must reach an internal SAP/Jira host.
CONNECTOR_ALLOW_PRIVATE_NETWORKS=false
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
SSO_ALLOW_PRIVATE_NETWORKS=false
CONNECTOR_RATE_LIMIT_PER_SECOND=5
CONNECTOR_RATE_LIMIT_BURST=10
CONNECTOR_HEALTH_INTERVAL_MS=300000
CONNECTOR_GIT_TIMEOUT_MS=60000
WEBHOOK_RETRY_INTERVAL_MS=30000
# Resolver(s) for SSO domain TXT verification, e.g. 1.1.1.1,8.8.8.8 (empty = system resolver).
SSO_DNS_SERVERS=
# Ed25519 seed (openssl rand -hex 32) for signing local-agent jobs and update manifests.
# Empty: derived from MASTER_ENCRYPTION_KEY.
AGENT_JOB_SIGNING_KEY=
AGENT_HEARTBEAT_INTERVAL_SEC=60
AGENT_HEARTBEAT_STALE_MS=300000
# Signed update manifest per channel (JSON: {"version","url","sha256"}); empty = no update offered.
AGENT_UPDATE_MANIFEST_STABLE=
AGENT_UPDATE_MANIFEST_BETA=

# ------------------------------------------------------------------------------
# E-mail delivery & account lifecycle (REQUIRED in production)
# Used for e-mail verification, password reset, organization invitations and
# security notifications. The API refuses to start in production without
# MAIL_TRANSPORT and MAIL_FROM.
#   smtp : any SMTP relay (implicit TLS on 465, STARTTLS on 587). Credentials are
#          never sent over an unencrypted connection.
#   http : transactional provider API — MAIL_HTTP_PROVIDER=resend|postmark.
#   dev  : stores messages in the mail_outbox table and serves them at
#          GET /api/v1/dev/mail/messages?to=<address> (header X-Dev-Mailbox-Token).
#          Only for staging / E2E stacks; in production it requires
#          MAIL_DEV_OUTBOX_TOKEN (>= 24 chars) and nothing is delivered.
# ------------------------------------------------------------------------------
MAIL_TRANSPORT=smtp
MAIL_FROM="ERP Preflight <no-reply@erppreflight.com>"
# Public web origin used in e-mail links (defaults to the first CORS_ORIGIN).
APP_PUBLIC_URL=https://erppreflight.com
# Support ticket e-mails (created / replied / status changed): operator inbox that
# receives every ticket event (empty = only the requester is e-mailed) and the
# language of those inbox e-mails (en | de). Requesters get the ticket's language.
SUPPORT_INBOX_EMAIL=support@erppreflight.com
SUPPORT_INBOX_LOCALE=en
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# tls | starttls | none (default: tls for port 465, otherwise starttls)
SMTP_SECURE=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_TIMEOUT_MS=20000
# HTTP provider alternative (MAIL_TRANSPORT=http)
MAIL_HTTP_PROVIDER=resend
MAIL_HTTP_URL=
MAIL_HTTP_API_KEY=
# Dev mailbox token (MAIL_TRANSPORT=dev only; leave empty in production)
MAIL_DEV_OUTBOX_TOKEN=
# Unverified accounts can sign in and upload but cannot run analyses, export
# reports, mint API keys or send invitations. Set false only for closed pilots.
EMAIL_VERIFICATION_REQUIRED=true

# ------------------------------------------------------------------------------
# Billing (Stripe). Without STRIPE_SECRET_KEY checkout/portal/invoices return 503
# ("billing not configured"); plan limits and usage metering still apply.
# Checkout returnUrl must be on an origin listed in BILLING_RETURN_ORIGINS / CORS_ORIGIN.
# Webhook endpoint: POST /api/v1/billing/webhook (checkout.session.completed,
# customer.subscription.created|updated|deleted, invoice.payment_failed, invoice.paid).
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# stripe | local (non-production simulator, refused in production) | none. Default: stripe if key set.
BILLING_PROVIDER=
# Optional Stripe Price ids per self-service tier (else price_data from the plan catalog).
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PROFESSIONAL=
# Optional list-price overrides in EUR per tier (catalog: packages/schemas/src/plans.ts).
PLAN_PRICE_EUR_STARTER=
PLAN_PRICE_EUR_PROFESSIONAL=
BILLING_RETURN_ORIGINS=
# Trial granted at organization creation (0 disables); downgrade to plan_tier on expiry.
TRIAL_DAYS=14
TRIAL_PLAN_TIER=PROFESSIONAL
# Governance sweep (retention purges + trial expiry), BullMQ repeatable job. 'off' disables.
# RETENTION_SWEEP_CRON=17 * * * *   (default)

# ------------------------------------------------------------------------------
# Antivirus (ClamAV) — MUST stay false in production (fail-closed ingestion)
# ------------------------------------------------------------------------------
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_MOCK_MODE=false

# Maximum multipart upload size in MB (API answers 413 above it)
MAX_UPLOAD_SIZE_MB=100

# --- Knowledge graph / release intelligence (docs/KNOWLEDGE_GRAPH.md) ---
# Weekly SAP Cloudification Repository sync (cron, UTC). "off" disables the schedule (admin trigger + CLI still work).
KNOWLEDGE_SYNC_CRON=17 3 * * 1
# Optional comma-separated subset of repository files (default: all 13 known files).
KNOWLEDGE_CR_FILES=
# Hourly stale-source check (Source Sync Admin, spec 10.12): opens an alert and notifies every
# super admin when a critical knowledge source exceeds its freshness threshold. "off" disables it.
SOURCE_FRESHNESS_CRON=41 * * * *

# --- AI gateway (Part 03 §3.9, section C §37/§38) ---
# Used only for advisory features (Problem Router second opinion, finding explanations) and only
# for organizations whose data policy allows AI assistance. Results are capped at INFERRED (0.60).
# Provider: ANTHROPIC | OPENAI | OLLAMA_LOCAL (any OpenAI-compatible endpoint, e.g. a local model
# for development) | unset = deterministic only (no model is ever called).
AI_DEFAULT_PROVIDER=
ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
AI_OLLAMA_MODEL=llama3.1
OLLAMA_LOCAL_API_KEY=
# Per-task models, fallback, token limits, temperature, privacy mode, monthly cost ceilings and a
# global kill switch per provider are managed at runtime by super admins in AI Admin (/admin/ai);
# the variables above are the platform defaults used when a task has no override.
