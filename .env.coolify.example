# ==============================================================================
# ERP Preflight — Coolify / Hostinger Production Environment Variables (.env)
# ==============================================================================
# Place these values into your Coolify Project/Application Environment Settings.
# ==============================================================================

# Node Environment
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Domain & Ports
PORT=4000
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=https://api.erppreflight.com
CORS_ORIGIN=https://erppreflight.com,https://www.erppreflight.com

# PostgreSQL 16 + pgvector Credentials
POSTGRES_DB=erppreflight
POSTGRES_USER=erppreflight_user
POSTGRES_PASSWORD=GENERATE_SECURE_STRONG_PASSWORD_HERE
DATABASE_URL=postgres://erppreflight_user:GENERATE_SECURE_STRONG_PASSWORD_HERE@postgres:5432/erppreflight
AUTO_MIGRATE=true
STRICT_MIGRATIONS=false

# Redis Configuration (Internal Docker Network)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Analysis Engine (Python FastAPI Internal URL)
ANALYSIS_SERVICE_URL=http://analysis-python:8000

# MinIO / S3 Object Storage Credentials
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=GENERATE_MINIO_ACCESS_KEY_HERE
S3_SECRET_KEY=GENERATE_MINIO_SECRET_KEY_HERE
S3_REGION=us-east-1
S3_BUCKET_QUARANTINE=erppreflight-quarantine
S3_BUCKET_CLEAN=erppreflight-clean
S3_BUCKET_REPORTS=erppreflight-reports

# JWT & Authentication Secret (Generate at least 64 random characters)
# Example: openssl rand -base64 48
JWT_SECRET=GENERATE_SECURE_JWT_SECRET_AT_LEAST_64_CHARS_HERE
JWT_EXPIRES_IN=7d
