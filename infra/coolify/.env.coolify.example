# ==============================================================================
# ERP Preflight — Coolify / Hostinger VPS Production Environment Configuration
# ==============================================================================
# Paste these variables directly into the Coolify Environment Variables editor
# for the ERP Preflight Docker Compose project.
# ==============================================================================

# 1. Environment & Mode
NODE_ENV=production
AUTO_MIGRATE=true
STRICT_MIGRATIONS=false

# 2. Service Ports
PORT=3001
API_PORT=3001
WEB_PORT=3000
ANALYSIS_PORT=8000
PYTHON_PORT=8000

# 3. Routing & Public URLs
NEXT_PUBLIC_API_URL=https://api.erppreflight.com
ANALYSIS_SERVICE_URL=http://analysis-python:8000
NEXT_TELEMETRY_DISABLED=1

# 4. PostgreSQL 16 + pgvector
POSTGRES_DB=erppreflight
POSTGRES_USER=erppreflight
POSTGRES_PASSWORD=erppreflight_secret_change_me_in_production_32chars
POSTGRES_PORT=5432
DATABASE_URL=postgres://erppreflight:erppreflight_secret_change_me_in_production_32chars@postgres:5432/erppreflight

# 5. Redis 7.2 & BullMQ
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# 6. S3-Compatible Storage (MinIO)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_secret_change_me_in_production_32chars
S3_REGION=us-east-1
S3_BUCKET_QUARANTINE=erppreflight-quarantine
S3_BUCKET_CLEAN=erppreflight-clean
S3_BUCKET_REPORTS=erppreflight-reports
MINIO_CONSOLE_PORT=9001

# 7. Authentication & Cryptography
JWT_SECRET=super-secret-jwt-key-must-be-at-least-32-chars-long-erppreflight
JWT_EXPIRES_IN=7d
MASTER_ENCRYPTION_KEY=erppreflight-default-master-key-32-chars-minimum-abcdef
CORS_ORIGIN=https://erppreflight.com,https://api.erppreflight.com,http://localhost:3000

# 8. Antivirus Ingestion Security
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_MOCK_MODE=false
# SECURITY: Must be false in production. ClamAV service must be running.

# 9. Python Analysis Service
PYTHONUNBUFFERED=1
SERVICE_VERSION=1.0.0
CORS_ORIGINS=http://api:3001,http://web:3000,http://localhost:3001,http://localhost:3000,https://erppreflight.com,https://api.erppreflight.com

# 10. Traefik / Coolify Domain Variables
COOLIFY_MANAGED=true
DOMAIN_WEB=erppreflight.com
DOMAIN_API=api.erppreflight.com
TRAEFIK_CERTRESOLVER=letsencrypt
