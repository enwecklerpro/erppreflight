# ==============================================================================
# ERP Preflight — Multi-stage hardened non-root Dockerfile for Python Analysis Microservice
# ==============================================================================

# Stage 1: Build Python wheels and dependencies
FROM python:3.13-slim@sha256:7c61056e61ac89e852de05f3dc6fa51a6dd2181797bceed46aa725dd7cb2cd3b AS builder

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc libxml2-dev libxslt-dev && \
    rm -rf /var/lib/apt/lists/*

COPY services/analysis-python/requirements.txt ./
RUN pip install --no-cache-dir --user -r requirements.txt

# Stage 2: Hardened production runner
FROM python:3.13-slim@sha256:7c61056e61ac89e852de05f3dc6fa51a6dd2181797bceed46aa725dd7cb2cd3b AS runner

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/home/appuser/.local/bin:$PATH"

# Security: create non-root user and group (UID/GID 1001)
RUN groupadd -g 1001 appgroup && \
    useradd -u 1001 -g appgroup -s /bin/bash -m appuser

# Install curl for healthcheck probes and clean up apt cache.
# pip is not used at runtime (dependencies are copied from the builder stage); its vendored
# packages (msgpack, setuptools) carry fixable HIGH CVEs that fail the blocking Trivy image
# scan, so it is uninstalled (spec 20.8 "no build tools if unnecessary").
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/* && \
    python -m pip uninstall -y pip && \
    rm -rf /usr/local/lib/python3.13/ensurepip /root/.cache

# Copy installed dependencies and service code with non-root ownership
COPY --from=builder --chown=appuser:appgroup /root/.local /home/appuser/.local
COPY --chown=appuser:appgroup services/analysis-python/ ./

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=5 \
  CMD curl -f http://127.0.0.1:8000/health || exit 1

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
