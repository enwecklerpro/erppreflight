# ==============================================================================
# ERP Preflight — Multi-stage hardened non-root Dockerfile for NestJS Core API
# ==============================================================================

# Stage 1: Build dependencies & compilation
FROM node:22.23.3-alpine3.24@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS builder

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.20.0 --activate

# Copy monorepo configuration
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/

# Install dependencies and build API & internal packages
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @erppreflight/schemas build && \
    pnpm --filter @erppreflight/evidence build && \
    pnpm --filter @erppreflight/tenancy build && \
    pnpm --filter @erppreflight/auth build && \
    pnpm --filter @erppreflight/database build && \
    pnpm --filter @erppreflight/api build

# Stage 2: Production runner
FROM node:22.23.3-alpine3.24@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3001
ENV API_PORT=3001
ENV AUTO_MIGRATE=true

# The read-only Git (abapGit) connector shells out to the git client (shallow clones in a temp sandbox).
RUN apk add --no-cache git

# Security: create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nestjs

# Install production dependencies only
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/api/package.json ./apps/api/
# Hardening (spec 20.8 "no build tools if unnecessary"): the runtime only needs `node`.
# After the production install, npm, yarn and corepack (whose bundled dependencies carry
# fixable HIGH CVEs flagged by the blocking Trivy image scan) are removed with the caches.
RUN corepack enable && corepack prepare pnpm@10.20.0 --activate && \
    pnpm install --prod --frozen-lockfile && \
    corepack disable && \
    rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
           /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
           /usr/local/bin/yarn /usr/local/bin/yarnpkg /opt/yarn-* \
           /root/.cache /root/.local/share/pnpm /root/.npm

# Copy built artifacts
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/packages/database/dist ./packages/database/dist
COPY --from=builder /app/packages/database/migrations ./packages/database/migrations
COPY --from=builder /app/packages/schemas/dist ./packages/schemas/dist
COPY --from=builder /app/packages/evidence/dist ./packages/evidence/dist
COPY --from=builder /app/packages/auth/dist ./packages/auth/dist
COPY --from=builder /app/packages/tenancy/dist ./packages/tenancy/dist

# Ensure main.js is accessible at both dist/src/main.js and dist/main.js
RUN if [ -f ./apps/api/dist/src/main.js ] && [ ! -f ./apps/api/dist/main.js ]; then \
      cp ./apps/api/dist/src/main.js ./apps/api/dist/main.js; \
    fi

# Copy automated migration runner and container entrypoint
COPY infra/docker/api-entrypoint.sh ./entrypoint.sh
RUN chmod +x ./entrypoint.sh && chown -R nestjs:nodejs /app

USER nestjs

EXPOSE 3001

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:${PORT:-3001}/health/liveness || exit 1

ENTRYPOINT ["./entrypoint.sh"]
