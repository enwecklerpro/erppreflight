# ==============================================================================
# ERP Preflight - Master Environment Configuration Template
# ==============================================================================

# Node / Environment
NODE_ENV=development
PORT=4000
API_PORT=4000
WEB_PORT=3000
PYTHON_PORT=8000

# PostgreSQL 16 + pgvector
DATABASE_URL=postgres://erppreflight:erppreflight_secret@localhost:5432/erppreflight_dev
POSTGRES_DB=erppreflight_dev
POSTGRES_USER=erppreflight
POSTGRES_PASSWORD=erppreflight_secret
POSTGRES_PORT=5432

# Redis 7 (Local dev host port mapped to 6380 to avoid collision with host dj-redis)
REDIS_URL=redis://localhost:6380
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# JWT & Authentication
JWT_SECRET=super-secret-jwt-key-must-be-at-least-32-chars-long-erppreflight
JWT_EXPIRES_IN=7d

# Analysis Engine (Python FastAPI)
ANALYSIS_SERVICE_URL=http://localhost:8000

# S3 / Object Storage (MinIO or AWS)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET_QUARANTINE=erppreflight-quarantine
S3_BUCKET_CLEAN=erppreflight-clean
S3_BUCKET_REPORTS=erppreflight-reports

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://erppreflight.com
