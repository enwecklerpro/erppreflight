# ==============================================================================
# ERP Preflight — Master Production & Development Environment Template
# ==============================================================================
# This template documents all environment variables across all services:
#   - web:              Next.js 15 App Router Frontend (Port 3000)
#   - api:              NestJS 11 Core SaaS API Backend (Port 3001)
#   - analysis-python:  Python 3.13 FastAPI Stateless Microservice (Port 8000)
#   - postgres:         PostgreSQL 16 + pgvector Multi-Tenant Persistence (Port 5432)
#   - redis:            Redis 7.2 Cache & BullMQ Job Queue (Port 6379)
#   - minio:            MinIO S3-Compatible Object Store (Ports 9000 / 9001)
#
# Target Infrastructure: Hostinger VPS / Coolify v4+ / Traefik Reverse Proxy
# Synchronized with: apps/api/src/config/env.validation.ts & docker-compose.coolify.yml
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Runtime Mode
# ------------------------------------------------------------------------------
# Options: development | production | test
NODE_ENV=production

# Automated database schema migration runner on container startup
# When 'true', runs migrations in packages/database/migrations prior to server boot
AUTO_MIGRATE=true

# Strict migration mode:
# When 'true', container exits with code 1 if migrations fail
# When 'false', container logs a warning and proceeds with server startup
STRICT_MIGRATIONS=false

# ------------------------------------------------------------------------------
# 2. Service Ports & Topology
# ------------------------------------------------------------------------------
# Port for NestJS 11 API service (Container and Host)
PORT=3001
API_PORT=3001

# Port for Next.js 15 Web Frontend (Container and Host)
WEB_PORT=3000

# Port for Python 3.13 FastAPI Analysis Engine (Container and Host)
ANALYSIS_PORT=8000
PYTHON_PORT=8000

# External Public API URL accessed by client-side browser components
NEXT_PUBLIC_API_URL=https://api.erppreflight.com

# Internal API-to-Analysis Microservice communication endpoint
# In Docker network: http://analysis-python:8000 | Local dev: http://localhost:8000
ANALYSIS_SERVICE_URL=http://analysis-python:8000

# Disable Next.js anonymous telemetry collection
NEXT_TELEMETRY_DISABLED=1

# ------------------------------------------------------------------------------
# 3. PostgreSQL 16 + pgvector Persistence
# ------------------------------------------------------------------------------
# Primary relational database name
POSTGRES_DB=erppreflight

# Database administrator / application role
POSTGRES_USER=erppreflight

# Database password (CHANGE THIS IN PRODUCTION!)
POSTGRES_PASSWORD=erppreflight_secret_change_me_in_production_32chars

# Database host port
POSTGRES_PORT=5432

# Complete connection string used by Drizzle ORM and migration runners
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://erppreflight:erppreflight_secret_change_me_in_production_32chars@postgres:5432/erppreflight

# ------------------------------------------------------------------------------
# 4. Redis 7.2 & BullMQ Job Queue Backend
# ------------------------------------------------------------------------------
# Redis hostname (service name in docker-compose)
REDIS_HOST=redis

# Redis port
REDIS_PORT=6379

# Redis authentication password (leave empty if password is not configured)
REDIS_PASSWORD=

# Complete Redis URI for BullMQ queue connections
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# 5. S3-Compatible Object Storage (MinIO / AWS S3)
# ------------------------------------------------------------------------------
# S3 API endpoint
# In Docker network: http://minio:9000 | Local dev: http://localhost:9000 | AWS: https://s3.amazonaws.com
S3_ENDPOINT=http://minio:9000

# S3 Access Key / MinIO Root User
S3_ACCESS_KEY=minioadmin

# S3 Secret Key / MinIO Root Password (CHANGE THIS IN PRODUCTION!)
S3_SECRET_KEY=minioadmin_secret_change_me_in_production_32chars

# AWS / MinIO storage region
S3_REGION=us-east-1

# Quarantine bucket for unverified uploaded customer artifacts
S3_BUCKET_QUARANTINE=erppreflight-quarantine

# Clean bucket for sanitized, validated artifacts
S3_BUCKET_CLEAN=erppreflight-clean

# Reports bucket for generated preflight assessment audit reports (PDF/JSON/CSV)
S3_BUCKET_REPORTS=erppreflight-reports

# MinIO Web Console management port (browser UI)
MINIO_CONSOLE_PORT=9001

# ------------------------------------------------------------------------------
# 6. Authentication, Security & Cryptography
# ------------------------------------------------------------------------------
# Secret key used for signing JWT access tokens (MUST be at least 32 characters!)
JWT_SECRET=super-secret-jwt-key-must-be-at-least-32-chars-long-erppreflight

# JWT access token validity duration
JWT_EXPIRES_IN=7d

# Master AES-256-GCM encryption key for customer secret and credential storage
# MUST be at least 32 characters!
MASTER_ENCRYPTION_KEY=erppreflight-default-master-key-32-chars-minimum-abcdef

# Comma-separated list of allowed CORS origins for NestJS API
CORS_ORIGIN=https://erppreflight.com,https://api.erppreflight.com,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 7. Antivirus & Ingestion Pipeline Security (ClamAV)
# ------------------------------------------------------------------------------
# ClamAV daemon hostname
CLAMAV_HOST=clamav

# ClamAV daemon TCP port
CLAMAV_PORT=3310

# Mock mode for environments where ClamAV daemon is not running
# Set to 'false' in enterprise production with active ClamAV container
CLAMAV_MOCK_MODE=true

# ------------------------------------------------------------------------------
# 8. Python 3.13 FastAPI Analysis Engine Configuration
# ------------------------------------------------------------------------------
# Prevent Python from writing .pyc files
PYTHONUNBUFFERED=1

# Microservice semantic version
SERVICE_VERSION=1.0.0

# Allowed CORS origins for FastAPI analysis service
CORS_ORIGINS=http://api:3001,http://web:3000,http://localhost:3001,http://localhost:3000,https://erppreflight.com,https://api.erppreflight.com

# ------------------------------------------------------------------------------
# 9. Hostinger & Coolify Reverse Proxy Routing (Traefik)
# ------------------------------------------------------------------------------
# Coolify deployment indicator
COOLIFY_MANAGED=true

# Primary Web Frontend domain name
DOMAIN_WEB=erppreflight.com

# Core API Backend domain name
DOMAIN_API=api.erppreflight.com

# Traefik TLS resolver (configured in Coolify)
TRAEFIK_CERTRESOLVER=letsencrypt
