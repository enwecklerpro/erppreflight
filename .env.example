# ==========================================
# ERP Preflight Environment Configuration
# ==========================================

# --- Required: Core Database ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/erppreflight
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-in-production
POSTGRES_DB=erppreflight
AUTO_MIGRATE=true
STRICT_MIGRATIONS=false
MIGRATIONS_DIR=./migrations

# --- Required: Redis ---
REDIS_URL=redis://localhost:6379

# --- Required: Authentication ---
JWT_SECRET=changeme-generate-a-64-char-random-string
ADMIN_BOOTSTRAP_PASSWORD=changeme-strong-admin-password
SUPER_ADMIN_EMAIL=admin@erppreflight.com

# --- Required: Object Storage (MinIO/S3) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# --- Required: Analysis Service ---
ANALYSIS_SERVICE_URL=http://localhost:8000

# --- Optional: Stripe Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Optional: AI Providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional: SAP Cloud ALM ---
CLOUD_ALM_TOKEN_URL=
CLOUD_ALM_CLIENT_ID=
CLOUD_ALM_CLIENT_SECRET=
CLOUD_ALM_API_BASE_URL=
SAP_CLOUD_ALM_TOKEN_URL=
SAP_CLOUD_ALM_CLIENT_ID=
SAP_CLOUD_ALM_CLIENT_SECRET=
SAP_CLOUD_ALM_API_URL=

# --- Optional: Jira ---
JIRA_HOST=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# --- Optional: CI / External ---
ERP_PREFLIGHT_API_URL=
ERP_PREFLIGHT_API_KEY=
PLAYWRIGHT_BASE_URL=
DOCKER_BUILD=
CI=
HOSTNAME=

# --- Security: Antivirus ---
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_MOCK_MODE=false
# SECURITY: CLAMAV_MOCK_MODE must be false in production

# --- Security: Network ---
ALLOW_LOCAL_LANDSCAPE_PROBES=false
ALLOW_PRIVATE_LANDSCAPE_PROBES=false
CORS_ORIGIN=http://localhost:3000

# --- Application ---
NODE_ENV=development
PORT=3001
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
OPENAPI_SPEC_URL=http://localhost:3001/api-json
