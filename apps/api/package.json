    "knowledge:sync": "node dist/src/modules/knowledge-graph/cli/knowledge-sync.cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/s3-request-presigner": "^3.1139.0",
    "@erppreflight/auth": "workspace:*",
    "@erppreflight/database": "workspace:*",
    "@erppreflight/evidence": "workspace:*",
    "@erppreflight/schemas": "workspace:*",
    "@erppreflight/tenancy": "workspace:*",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.11",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/swagger": "^11.0.6",
    "@node-rs/argon2": "^2.2.1",
    "archiver": "^8.0.0",
    "bullmq": "^5.41.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "exceljs": "^4.4.0",
    "ioredis": "^5.6.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.1",
    "rxjs": "^7.8.1",
    "unzipper": "^0.12.5",
    "uuid": "^10.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.0.11",
    "@types/archiver": "^8.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.11",
    "@types/unzipper": "^0.10.11",
    "@types/uuid": "^10.0.0",
